#!/bin/bash
# Stable LEAD-GRPO continuation job based on the normalphased main_ppo template.
# Resumes from step-50 checkpoint and trains to step 75 with high rollout window.

#SBATCH --job-name=tinyzero_lead_grpo_stable
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --gres=gpu:4
#SBATCH --cpus-per-task=64
#SBATCH --mem=600G
#SBATCH --time=02:00:00

module purge
module load 2025
module load CUDA/12.8.0

source ~/.bashrc
conda activate zero

# Ensure ROCm vars do not conflict with CUDA
unset ROCR_VISIBLE_DEVICES
unset HIP_VISIBLE_DEVICES

export HF_HOME=/scratch-shared/$USER/huggingface
mkdir -p $HF_HOME
export WANDB__SERVICE_WAIT=300
export WANDB_DIR=/scratch-shared/$USER/wandb
mkdir -p $WANDB_DIR

cd $HOME/TinyZero

export N_GPUS=4
export ROLLOUT_TP_SIZE=1
export DATA_DIR=$PWD
export BASE_MODEL=deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B
export EXPERIMENT_NAME=test_lead_grpo_new


python3 -m verl.trainer.main_ppo \
    data.train_files=$DATA_DIR/train.parquet \
    data.val_files=$DATA_DIR/test.parquet \
    data.train_batch_size=256 \
    data.val_batch_size=256 \
    data.dataloader_num_workers=2 \
    data.max_prompt_length=256 \
    data.max_response_length=2048 \
    actor_rollout_ref.model.path=$BASE_MODEL \
    actor_rollout_ref.model.use_remove_padding=True \
    actor_rollout_ref.actor.use_dynamic_bsz=True \
    actor_rollout_ref.actor.optim.lr=1e-6 \
    actor_rollout_ref.actor.ppo_mini_batch_size=32 \
    actor_rollout_ref.actor.ppo_micro_batch_size=8 \
    actor_rollout_ref.rollout.n=4 \
    actor_rollout_ref.rollout.tensor_model_parallel_size=$ROLLOUT_TP_SIZE \
    actor_rollout_ref.rollout.name=vllm \
    actor_rollout_ref.rollout.gpu_memory_utilization=0.5 \
    actor_rollout_ref.rollout.log_prob_micro_batch_size=32 \
    actor_rollout_ref.ref.log_prob_micro_batch_size=8 \
    algorithm.adv_estimator=grpo \
    algorithm.norm_adv_by_std_in_grpo=True \
    algorithm.use_kl_in_reward=False \
    algorithm.kl_ctrl.kl_coef=0.001 \
    algorithm.incorrect_answer_penalty.enable=True \
    algorithm.incorrect_answer_penalty.penalty=-1.0 \
    algorithm.lead.enable=True \
    algorithm.lead.alpha=0.1 \
    algorithm.lead.tau=0.5 \
    algorithm.lead.beta=0.3 \
    algorithm.lead.epsilon=1e-6 \
    agent.entropy_logging.enable=False \
    agent.adaptive_window.enable=True \
    agent.adaptive_window.mode=phased \
    agent.adaptive_window.initial_window=1024 \
    agent.adaptive_window.max_window=2048 \
    agent.adaptive_window.phased_schedule='[[50,2048]]' \
    trainer.n_gpus_per_node=$N_GPUS \
    trainer.nnodes=1 \
    trainer.resume_from_path=auto\
    trainer.total_training_steps=0 \
    trainer.save_freq=75 \
    trainer.test_freq=15 \
    trainer.val_before_train=False \
    trainer.val_only=False \
    trainer.logger=['console','wandb'] \
    trainer.project_name=TinyZero \
    trainer.experiment_name=$EXPERIMENT_NAME \
    trainer.default_local_dir=$EXPERIMENT_NAME \
    2>&1 | tee verl_lead_grpo_stable_test.log
