#!/bin/bash
# Run checkpoint validation report with trainer-style val-only pipeline,
# then run quick comparative analysis on the produced outputs.
#
# Default behavior:
# - append one checkpoint into an existing checkpoint_eval run
# - use quick settings (20-sample validation subset)
#
# Common overrides when submitting:
#   NEW_MODEL_CKPT=test_lead_grpo_new/global_step_75 sbatch scripts/eval_checkpoint_report.job
#   RUN_DIR=reports/checkpoint_eval/checkpoint_eval_20260401_153904 sbatch scripts/eval_checkpoint_report.job
#   SAMPLE_COUNT=20 SAMPLE_MODE=random SAMPLE_SEED=42 sbatch scripts/eval_checkpoint_report.job

#SBATCH --job-name=tinyzero_eval_report
#SBATCH --partition=gpu_h100
#SBATCH --nodes=1
#SBATCH --gres=gpu:4
#SBATCH --cpus-per-task=64
#SBATCH --mem=600G
#SBATCH --time=04:00:00

module purge
module load 2025
module load CUDA/12.8.0

source ~/.bashrc
conda activate zero

# Ensure ROCm vars do not conflict with CUDA
unset ROCR_VISIBLE_DEVICES
unset HIP_VISIBLE_DEVICES

export HF_HOME=/scratch-shared/$USER/huggingface
mkdir -p "$HF_HOME"
export WANDB__SERVICE_WAIT=300
export WANDB_DIR=/scratch-shared/$USER/wandb
mkdir -p "$WANDB_DIR"

cd "$HOME/TinyZero"

DATA_DIR=${DATA_DIR:-.}
SPLIT=${SPLIT:-test}
SAMPLE_COUNT=${SAMPLE_COUNT:-20}
SAMPLE_MODE=${SAMPLE_MODE:-random}
SAMPLE_SEED=${SAMPLE_SEED:-42}

TARGET_CKPT_ROOT=${TARGET_CKPT_ROOT:-test_lead_grpo_new}
NEW_MODEL_CKPT=${NEW_MODEL_CKPT:-$(ls -1d "${TARGET_CKPT_ROOT}"/global_step_* 2>/dev/null | sort | tail -n1)}

if [[ -z "${NEW_MODEL_CKPT}" ]]; then
  echo "No checkpoint found under ${TARGET_CKPT_ROOT}/global_step_*"
  exit 1
fi

if [[ ! -d "${NEW_MODEL_CKPT}/actor" ]]; then
  echo "Checkpoint path is missing actor directory: ${NEW_MODEL_CKPT}"
  exit 1
fi

if [[ -n "${RUN_DIR:-}" ]]; then
  EXISTING_RUN_DIR="${RUN_DIR}"
else
  EXISTING_RUN_DIR=$(ls -1d reports/checkpoint_eval/checkpoint_eval_* 2>/dev/null | sort | tail -n1)
fi

if [[ -z "${EXISTING_RUN_DIR}" ]]; then
  echo "No existing checkpoint_eval run found under reports/checkpoint_eval"
  exit 1
fi

echo "Appending checkpoint: ${NEW_MODEL_CKPT}"
echo "Target run dir: ${EXISTING_RUN_DIR}"
echo "Sample settings: count=${SAMPLE_COUNT}, mode=${SAMPLE_MODE}, seed=${SAMPLE_SEED}"

DATA_DIR="${DATA_DIR}" \
SPLIT="${SPLIT}" \
SAMPLE_COUNT="${SAMPLE_COUNT}" \
SAMPLE_MODE="${SAMPLE_MODE}" \
SAMPLE_SEED="${SAMPLE_SEED}" \
bash scripts/run_checkpoint_eval_report.sh \
  --checkpoints "${NEW_MODEL_CKPT}" \
  --append-run-dir "${EXISTING_RUN_DIR}"

python3 scripts/analyze_checkpoint_eval_outputs.py --run-dir "${EXISTING_RUN_DIR}"
